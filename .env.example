# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Neon Postgres via Vercel Marketplace (pooled connection string, auto-injected
# on Vercel as DATABASE_URL). Free tier, scale-to-zero.
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require"

# Contentful: reuse the personal-portfolio space (same SPACE_ID + CDA token).
# Add the quiz/question content types there per docs/content-model.md.
CONTENTFUL_SPACE_ID=""
CONTENTFUL_ACCESS_TOKEN=""

# Contentful Management token (local seeding via scripts/seed-demo-quiz.mjs only).
# Never set this on Vercel.
# CONTENTFUL_MANAGEMENT_TOKEN=""

# Site title used in page metadata.
NEXT_PUBLIC_SITE_TITLE="Quizper"
